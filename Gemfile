# Gems for the regress suite. Installed into ./vendor/bundle by .bundle/config,
# so nothing is written outside the repository.
#
#   bundle install
#   bundle exec ruby regress/pane-border-edges-test.rb

source 'https://rubygems.org'

# Test framework for the Ruby regress tests (regress/*-test.rb). Ruby ships
# with a minitest, but pinning it here keeps every machine on the same one.
gem 'minitest', '~> 5.25'

# Used by the Rakefile to build tmux and run the suite.
gem 'rake', '~> 13.2'
